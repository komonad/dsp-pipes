root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:suggestion

[src/API/*.cs]
dotnet_naming_rule.public_members_use_pascal_case.severity = warning
dotnet_naming_rule.public_members_use_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_use_pascal_case.style = pascal_case
dotnet_naming_symbols.public_members.applicable_kinds = class, struct, enum, property, method, field
dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_style.pascal_case.capitalization = pascal_case
